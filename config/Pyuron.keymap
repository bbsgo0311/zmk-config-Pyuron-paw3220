#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        btn1 {
            bindings = <&mkp MB1>;
            key-positions = <16 17>;
        };

        btn2 {
            bindings = <&mkp MB2>;
            key-positions = <17 18>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&to_layer_0>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W                &kp E         &kp R       &kp T               &kp Y            &kp U          &kp I        &kp O              &kp P
&kp A             &kp S                &kp D         &lt 1 F     &kp G               &kp H            &lt 1 J        &kp K        &kp L              &mt RIGHT_CONTROL MINUS
&mt LEFT_SHIFT Z  &kp X                &kp C         &kp V       &kp B               &none            &none          &kp N        &kp M              &kp COMMA
&kp DOT           &mt RIGHT_SHIFT F11  &lt 5 ESCAPE  &kp K_MUTE  &mt LEFT_GUI SPACE  &mt LEFT_ALT F6  &kp BACKSPACE  &lt 2 ENTER  &kp RIGHT_CONTROL  &kp TAB
            >;
        };

        layer_1 {
            bindings = <
&kp DOLLAR        &kp AMPERSAND      &kp QUESTION          &kp EXCLAMATION        &kp PERCENT  &kp TILDE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PLUS
&kp ASTERISK      &kp HASH           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT       &kp COLON      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SLASH    &kp BACKSLASH  &kp ASTERISK  &kp SLASH     &kp NUMBER_7  &kp NUMBER_8
&kp NUMBER_9      &kp EQUAL          &trans                &trans                 &trans       &trans         &kp PERIOD    &kp NUMBER_0  &trans        &trans
            >;
        };

        layer_2 {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS      &trans     &kp RG(LEFT_ARROW)    &kp UP_ARROW          &kp LG(RIGHT)             &kp LG(PLUS)
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &trans     &kp LEFT              &kp DOWN_ARROW        &kp RIGHT_ARROW           &kp LG(MINUS)
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL  &kp LG(LS(NUMBER_3))  &kp LG(LS(NUMBER_4))  &kp LS(LG(LC(NUMBER_4)))  &kp LG(LC(LS(NUMBER_5)))
&trans                      &trans           &trans           &trans           &trans        &trans     &trans                &trans                &trans                    &trans
            >;
        };

        layer_3 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans   &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans      &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans      &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans      &trans  &trans  &trans  &trans        &bootloader   &trans        &trans        &trans
&trans  &bt BT_CLR  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };
    };
};
